<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Health & Emergency - Smart Watch Ultra Nano 3</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes radar-ping {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    .animate-radar { animation: radar-ping 1.8s cubic-bezier(0, 0.2, 0.8, 1) infinite; }
    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fade-in-up 0.6s ease-out forwards; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans">
  <!-- Navigation Header -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <h1 class="text-xl font-bold bg-gradient-to-r from-orange-400 to-amber-200 bg-clip-text text-transparent">
        Smart Watch Ultra Nano 3
      </h1>
      <nav class="flex space-x-6 text-sm font-medium">
        <a href="product.html" class="text-slate-400 hover:text-orange-400 transition">Home</a>
        <a href="fitness.html" class="text-slate-400 hover:text-orange-400 transition">Fitness & Sports</a>
        <a href="connectivity.html" class="text-slate-400 hover:text-orange-400 transition">Connectivity</a>
        <a href="health.html" class="text-red-400 border-b-2 border-red-400 pb-1">Health & SOS</a>
      </nav>
    </div>
  </header>

  <!-- Health & SOS Content -->
  <main class="max-w-5xl mx-auto px-4 py-12 animate-fade-in">
    <div class="text-center mb-12">
      <span class="text-red-400 text-sm font-semibold tracking-wider uppercase">Category 03</span>
      <h2 class="text-4xl font-extrabold mt-2 mb-4">Vital Monitoring & Emergency SOS</h2>
      <p class="text-slate-400 max-w-xl mx-auto">Advanced vital telemetry sensors protect your health around the clock.</p>
    </div>

    <!-- SOS Beacon Visualizer -->
    <div class="bg-slate-900/80 border border-red-500/30 rounded-2xl p-8 mb-12 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="relative flex items-center justify-center w-32 h-32 flex-shrink-0">
        <span class="absolute w-full h-full rounded-full bg-red-500/30 animate-radar"></span>
        <div class="relative z-10 w-20 h-20 bg-red-600 rounded-full flex items-center justify-center font-black text-xl text-white shadow-lg shadow-red-600/50">
          SOS
        </div>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-red-400 mb-2">Automated Crash & Fall Detection</h3>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          Equipped with high-g accelerometer and gyroscopic sensors. Detects severe car collisions or sudden hard falls and automatically broadcasts your GPS location to emergency services.
        </p>
        <div class="flex space-x-4 text-xs font-semibold text-slate-400">
          <span class="bg-slate-800 px-3 py-1 rounded-md"> Siren Output: 86 dB</span>
          <span class="bg-slate-800 px-3 py-1 rounded-md">86-Meter Emergency Beacon Range</span>
        </div>
      </div>
    </div>

    <!-- Health Metrics Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 hover:border-red-500/50 transition">
        <div class="flex items-center justify-between mb-4">
          <h4 class="font-bold text-lg">Blood Oxygen (SpO2)</h4>
          <span class="text-emerald-400 text-sm font-semibold">98% Normal</span>
        </div>
        <p class="text-slate-400 text-sm">
          Continuous background oxygen monitoring with custom alerts when level drops below safe thresholds.
        </p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 hover:border-red-500/50 transition">
        <div class="flex items-center justify-between mb-4">
          <h4 class="font-bold text-lg">Sleep Architecture</h4>
          <span class="text-indigo-400 text-sm font-semibold">7h 45m Tracked</span>
        </div>
        <p class="text-slate-400 text-sm">
          Detailed breakdown of REM, core, and deep sleep stages paired with respiration tracking.
        </p>
      </div>
    </div>

    <div class="text-center">
      <a href="product.html" class="inline-block bg-red-500 hover:bg-red-600 text-slate-950 font-bold px-8 py-3 rounded-full transition shadow-lg shadow-red-500/20">
        Back to Product Page
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 py-6 text-center text-slate-500 text-sm">
    Smart Watch Ultra Nano 3 &copy; 2026. All rights reserved.
  </footer>
</body>
</html>
